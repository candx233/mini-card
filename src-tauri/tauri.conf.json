{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Card",
  "version": "0.1.2",
  "identifier": "com.minicard.shell",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mini Card",
        "visible": false,
        "width": 992,
        "height": 672,
        "x": 520,
        "y": 250,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/AppData/Roaming/mini-card/icons/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
